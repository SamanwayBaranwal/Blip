# Your bot's name (shown in chat)
BOT_NAME=Pilot

# Optional extra channel: Telegram (the app works without it).
# From @BotFather, and your own user id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Leave empty to run on the Claude plan signed in on this Mac (Claude Code login).
# Or paste a key from https://platform.claude.com → API keys (pay-as-you-go, capped by DAILY_BUDGET_USD).
ANTHROPIC_API_KEY=

# Optional
WEB_PORT=8787
MODEL=claude-opus-5-5
EFFORT=high
DAILY_BUDGET_USD=10
# REVIEW_MODEL=claude-opus-5-5        (the independent Auto Review checker; defaults to MODEL)
# PROACTIVE_SCHEDULE=0 10,14,18 * * *  (when the primary bot looks for things to suggest)
# TIMEZONE=Asia/Kolkata               (defaults to this Mac's timezone)
