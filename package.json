{
  "name": "blip",
  "version": "1.0.0",
  "private": true,
  "description": "Blip \u2014 your own always-on AI agents (Grok Bot / Dots style) running on your Mac, controlled from your phone.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "test": "tsc && node --test --test-force-exit --test-timeout=60000 --test-concurrency=4 \"test/unit/*.test.mjs\"",
    "test:golden": "tsc && node test/golden/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@anthropic-ai/sdk": "^0.135.0",
    "@playwright/mcp": "^0.0.83",
    "@types/ws": "^8.18.2",
    "croner": "^10.0.1",
    "express": "^5.3.0",
    "geist": "^1.8.1",
    "grammy": "^1.46.0",
    "htm": "^3.1.1",
    "preact": "^11.0.1",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
